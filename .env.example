# ── Database (Supabase) ──────────────────────────────────────────────────
# Transaction pooler URL (pgbouncer=true) — used by Prisma at runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true&connection_limit=1"
# Direct connection URL — used only for migrations (prisma migrate)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# ── NextAuth v5 ──────────────────────────────────────────────────
# NextAuth v5 uses AUTH_SECRET (not NEXTAUTH_SECRET)
# Generate: openssl rand -base64 32
AUTH_SECRET="generate-with: openssl rand -base64 32"
# Your app URL — MUST change to production domain before deploying
AUTH_URL="http://localhost:3000"

# ── NVIDIA NIM ──────────────────────────────────────────────────
NVIDIA_API_KEY="nvapi-xxxx"

# ── Upstash Redis (Rate Limiting) ────────────────────────────────────
# Create free Redis database at: https://console.upstash.com
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-token-here"

# ── Public vars (exposed to browser) ────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
